# Docker Compose local development values.
# Copy this file to .env and replace every placeholder before starting services.
POSTGRES_PASSWORD=replace-with-a-local-database-password
JWT_SECRET=replace-with-a-long-random-secret

# Keep model credentials on the backend only. Never commit the real key.
QWEN_API_KEY=replace-with-your-qwen-api-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_EMBEDDING_API_KEY=replace-with-your-qwen-embedding-api-key
QWEN_EMBEDDING_MODEL=text-embedding-v3
QWEN_EMBEDDING_DIMENSION=1024

FRONTEND_URL=http://localhost

# Optional local demo data. Keep disabled unless you explicitly need the seeded demo.
ALLOW_DEMO_SEED=false
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=replace-with-at-least-12-characters
